{
  "manifest_version": 3,
  "name": "Audio+",
  "version": "0.12.0",
  "description": "Persistent local browser audio toolkit with one-click Fast and AI Karaoke.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Audio+ controls"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}

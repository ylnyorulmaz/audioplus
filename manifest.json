{
  "manifest_version": 3,
  "name": "Audio+",
  "version": "0.6.0",
  "description": "Make browser audio easier to hear with EQ, Dialogue Boost, Night Mode, Vocal Reduction, presets, and local processing.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Audio+",
    "default_popup": "popup.html"
  }
}

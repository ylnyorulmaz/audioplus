{
  "manifest_version": 3,
  "name": "Audio+",
  "version": "0.12.0",
  "description": "One-click persistent browser audio control with Smart Fix, Fast Karaoke, and local MDX WebGPU AI Karaoke.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Audio+ controls"
  }
}

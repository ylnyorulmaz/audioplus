{
  "manifest_version": 3,
  "name": "Audio+",
  "version": "0.11.0",
  "description": "Browser audio toolkit with Smart Fix, Fast Karaoke, and bounded local MDX WebGPU Live AI Karaoke beta.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Audio+",
    "default_popup": "popup.html"
  }
}
